# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-string

# Neon Postgres (use the connection string from the Neon dashboard)
# Prefer the direct connection for local `next dev` if the pooler causes issues
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudflare R2 (optional — leave unset to keep local public/media storage)
# Create an R2 bucket + API token with Object Read & Write, then enable public access
# (r2.dev subdomain or custom domain) so logos/favicons load in the browser.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Gmail (optional — required only for "Send form email" in Applications admin)
# Use a Google Account App Password (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional display name in the From header (defaults to Site Settings name)
# GMAIL_FROM_NAME=Scholarship Portal
